{
  "name": "imerzn-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright end-to-end test framework",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:signup": "playwright test tests/auth/traveler-signup.spec.ts",
    "test:localite-signup": "playwright test tests/auth/localite-signup-and-verify.spec.ts",
    "test:create-experience": "playwright test tests/localite/create-a-publish-experience.spec.ts",
    "test:create-gallery": "playwright test tests/localite/create-gallery.spec.ts",
    "test:preview-profile": "playwright test tests/localite/preview-profile.spec.ts",
    "test:follow-localite": "playwright test tests/localite/follow-localite.spec.ts",
    "test:edit-profile": "playwright test tests/localite/edit-profile.spec.ts",
    "test:share-profile": "playwright test tests/localite/share-profile.spec.ts",
    "test:wishlist": "playwright test tests/traveler/wishlist.spec.ts",
    "test:traveler-settings": "playwright test tests/traveler/settings.spec.ts",
    "test:search": "playwright test tests/traveler/search-localite.spec.ts",
    "test:stories": "playwright test tests/traveler/stories.spec.ts",
    "test:localite-settings": "playwright test tests/localite/localite-settings.spec.ts",
    "test:dashboard": "playwright test tests/traveler/dashboard-after-signup.spec.ts",
    "test:experience-details": "playwright test tests/traveler/experience-details.spec.ts",
    "test:booking": "playwright test tests/traveler/experience-booking.spec.ts",
    "test:localite-bookings": "playwright test tests/localite/localite-dashboard-after-bookings.spec.ts",
    "test:my-bookings-dashboard": "playwright test tests/traveler/traveler-dashboard-after-bookings.spec.ts",
    "test:cancel-booking": "playwright test tests/traveler/cancel-booking.spec.ts",
    "test:localite-cancel-booking": "playwright test tests/localite/localite-cancel-booking.spec.ts",
    "test:localite-flow": "playwright test tests/auth/localite-signup-and-verify.spec.ts && playwright test tests/localite/create-a-publish-experience.spec.ts && playwright test tests/localite/create-gallery.spec.ts && playwright test tests/localite/preview-profile.spec.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.8.3"
  }
}
