# Copy this file to .env and change the values for your machine.
# config/env.ts reads these settings; CI sets them in .github/workflows/playwright.yml.

# Site under test (default https://dev.imerzn.com).
BASE_URL=https://dev.imerzn.com

# Admin portal, used by the localite signup test (default https://dev.admin.imerzn.com).
ADMIN_BASE_URL=https://dev.admin.imerzn.com

# Signup tests create real accounts (and may send an SMS); they run only when this is true.
RUN_SIGNUP_TEST=true

# Local runs: true hides the browser (CI is always headless).
HEADLESS=false
